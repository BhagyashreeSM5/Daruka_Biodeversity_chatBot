# --- Database (external, hosted) ---
# Use your Supabase project's connection string, with the postgresql+psycopg2
# driver prefix SQLAlchemy needs (Supabase gives you a plain postgresql:// URI
# — just change the scheme). Get it from:
#   Supabase dashboard -> Project Settings -> Database -> Connection string
# Prefer the "Session pooler" (port 5432) or direct connection for this
# long-running app — NOT the "Transaction pooler" (port 6543), which is meant
# for serverless/short-lived connections and doesn't play well with
# SQLAlchemy's connection pooling.
#
# Example:
# DATABASE_URL=postgresql+psycopg2://postgres.abcdefghijk:YOUR-PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
#
# Any other hosted Postgres with the pgvector extension available (Neon,
# Render Postgres, RDS, etc.) works the same way — just swap this URL.
DATABASE_URL=postgresql+psycopg2://postgres:YOUR-PASSWORD@YOUR-PROJECT.supabase.co:5432/postgres

# Local embedding model (no API key needed) - runs via sentence-transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2

# OPTIONAL: only needed for free-text parsing / natural-language phrasing.
# System works fully without this key (falls back to rule-based parsing + templated responses).
GOOGLE_API_KEY=

# Retrieval
TOP_K_EVIDENCE=4
